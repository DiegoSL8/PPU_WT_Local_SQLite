<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 1. EL MAPA (Fondo completo) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapaFondo"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. TOP BAR (Buscador y Botón Opciones) -->
    <!-- Le damos marginTop="40dp" para que baje de la barra de estado -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="48dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/etBuscar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar calle o ciudad..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#212121" />

            <!-- Botón de Opciones (El de los 3 puntitos) -->
            <ImageButton
                android:id="@+id/btnOpciones"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Opciones"
                android:src="@android:drawable/ic_menu_more"
                app:tint="#1B5E20" /> <!-- Verde Bosque -->
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. PANEL LATERAL DE CLIMA (Fijo a la izquierda) -->
    <!-- Lo anclamos debajo del buscador (toBottomOf="@id/topBarCard") -->
    <androidx.cardview.widget.CardView
        android:id="@+id/panelLateral"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#1B5E20"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- VISTA COMPACTA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Ubicación Actual"
                android:textColor="#A5D6A7"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTempCompacta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="--°C"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tocar para detalles 🔽"
                android:textColor="#E8F5E9"
                android:textSize="12sp" />

            <!-- VISTA EXPANDIDA -->
            <LinearLayout
                android:id="@+id/vistaExpandida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="12dp"
                    android:background="#A5D6A7" />

                <TextView
                    android:id="@+id/tvVientoExpandido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="🌬️ Viento: -- km/h"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvUvExpandido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="☀️ Índice UV: --"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvAptoBanio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌊 Apto Baño: --"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 4. CONTROLES DEL MAPA (Esquina Inferior Derecha) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnGuardarPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:contentDescription="Guardar Pin"
            android:src="@android:drawable/ic_menu_save"
            app:backgroundTint="#FF6D00"
            app:tint="#FFFFFF" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:contentDescription="Zoom In"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="#FFFFFF"
            app:fabSize="mini"
            app:tint="#1B5E20" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:contentDescription="Zoom Out"
            android:src="@android:drawable/ic_delete"
            app:backgroundTint="#FFFFFF"
            app:fabSize="mini"
            app:tint="#1B5E20" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMiUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Mi Ubicación"
            android:src="@android:drawable/ic_menu_mylocation"
            app:backgroundTint="#FFFFFF"
            app:tint="#1B5E20" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>