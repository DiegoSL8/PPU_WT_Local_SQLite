<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- EL MAPA DE FONDO (Actualizado a FragmentContainerView) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapaFondo"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BARRA SUPERIOR BÚSQUEDA Y OPCIONES -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#99000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etBuscador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:inputType="text"
            android:hint="Buscar playa o calle..."
            android:textColorHint="#CCCCCC"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FFFFFF"
            android:importantForAutofill="no"/>

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:contentDescription="Menú"
            android:src="@android:drawable/ic_menu_sort_by_size" />
    </LinearLayout>

    <!-- PANEL INFERIOR DE CLIMA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#E6FFFFFF"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTituloClima"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PPU_W (Clima)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <!-- Temperatura -->
            <TextView
                android:id="@+id/tvTempAct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18°C"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginEnd="32dp"/>

            <!-- Datos extra (Viento, UV) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvVientoAct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Viento: 15 km/h" />
                <TextView
                    android:id="@+id/tvUvAct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UV: Moderado" />
            </LinearLayout>
        </LinearLayout>

        <!-- Amanecer / Atardecer y Favorito -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvAmanecer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☀️ 07:00 AM" />

            <TextView
                android:id="@+id/tvAtardecer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌙 19:30 PM" />

            <!-- Botón Favorito (Estrella) -->
            <ImageView
                android:id="@+id/btnFavorito"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Agregar a favoritos"
                android:src="@android:drawable/btn_star" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>