<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F5F5"> <!-- FONDO GRIS PERLA -->

    <!-- EL MAPA -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapaFondo"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 1. BUSCADOR (FONDO BLANCO, LUPA VERDE) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBuscador"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/etBuscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar ciudad... (Ej: Iquique)"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="#212121"
                android:textColorHint="#757575" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#1B5E20" /> <!-- LUPA VERDE BOSQUE -->
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 2. PANEL LATERAL (FONDO BLANCO) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/panelLateral"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cardBuscador"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- VISTA COMPACTA -->
            <LinearLayout
                android:id="@+id/vistaCompacta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="#1B5E20"/> <!-- ICONO VERDE BOSQUE -->

                <TextView
                    android:id="@+id/tvTempCompacta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="--°C"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

                <TextView
                    android:id="@+id/tvCiudadCompacta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Ubicación Actual"
                    android:textSize="16sp"
                    android:textColor="#546E7A" />
            </LinearLayout>

            <!-- VISTA EXPANDIDA -->
            <LinearLayout
                android:id="@+id/vistaExpandida"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="16dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvVientoExpandido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌬️ Viento: -- km/h"
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvUvExpandido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️ Índice UV: --"
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvAptoBanio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌊 Apto para Baño: --"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:layout_marginBottom="24dp"/>

                <!-- BOTÓN FAVORITOS (Fondo Verde, Letras Blancas) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIrFavoritos"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#388E3C"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:text="Mis Favoritos"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/btn_star"
                    app:iconTint="#FFFFFF"/>

                <!-- BOTÓN CERRAR SESIÓN (Fondo Blanco, Letras Rojas) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarSesion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FFEBEE"
                    android:textColor="#D32F2F"
                    android:textStyle="bold"
                    android:text="Cerrar Sesión"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_lock_power_off"
                    app:iconTint="#D32F2F"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. BOTONES DEL MAPA (FONDO BLANCO, ICONOS VERDES) -->
    <LinearLayout
        android:id="@+id/contenedorBotonesMapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMiUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="#1B5E20"
            app:backgroundTint="#FFFFFF"
            app:fabSize="normal" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="#1B5E20"
            app:backgroundTint="#FFFFFF"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_input_delete"
            app:tint="#1B5E20"
            app:backgroundTint="#FFFFFF"
            app:fabSize="mini" />
    </LinearLayout>

    <!-- 4. BOTÓN GUARDAR PIN (NARANJA MANDARINA) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnGuardarPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="32dp"
        android:src="@android:drawable/ic_menu_save"
        app:tint="#FFFFFF"
        app:backgroundTint="#FF6D00"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>